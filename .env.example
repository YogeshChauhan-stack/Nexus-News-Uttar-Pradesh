# Database configuration (PostgreSQL for Production, SQLite or Local DB in Dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_news?schema=public"

# News API Services (Optional for extended API sync)
NEWS_API_ORG_KEY=""
GNEWS_API_KEY=""

# Application Settings
NEXT_PUBLIC_SITE_NAME="Nexus News"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_DESCRIPTION="Breaking Global News, In-Depth Investigations, and Verified Journalism."

# Background Worker & Sync Security Token
CRON_SECRET_TOKEN="nexus-secure-sync-token-2026"
